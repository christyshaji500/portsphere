{
  "callNumber": "VC-2026-0006",
  "vessel_ID": "c1000000-0000-4000-8000-000000000999",
  "voyageNumber": "XX01",
  "shippingLine_ID": "b1000000-0000-4000-8000-000000000001",
  "agent_ID": "b1000000-0000-4000-8000-000000000003",
  "eta": "2026-11-20T02:00:00Z",
  "etd": "2026-11-21T14:00:00Z"
}

