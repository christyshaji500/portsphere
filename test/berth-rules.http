Content-Type: application/json

{
  "call_ID": "d1000000-0000-4000-8000-000000000003",
  "berth_ID": "a1000000-0000-4000-8000-000000000001",
  "fromTime": "2026-11-16T10:00:00Z",
  "toTime": "2026-11-16T20:00:00Z"
}

