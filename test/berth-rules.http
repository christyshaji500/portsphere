@ops = http://localhost:4004/operations

### 1) Should FAIL with TWO errors: ARABIAN SPIRIT (250 m / 15.2 m) at B05 (180 m / 10 m)
POST {{ops}}/VesselCalls
Content-Type: application/json

{
  "vessel_ID": "c1000000-0000-4000-8000-000000000004",
  "voyageNumber": "AS20",
  "shippingLine_ID": "b1000000-0000-4000-8000-000000000001",
  "agent_ID": "b1000000-0000-4000-8000-000000000003",
  "eta": "2026-11-20T02:00:00Z",
  "etd": "2026-11-21T14:00:00Z",
  "berthAllocations": [
    { "berth_ID": "a1000000-0000-4000-8000-000000000005", "fromTime": "2026-11-20T02:00:00Z", "toTime": "2026-11-21T14:00:00Z" }
  ]
}

