{
  "name": "portsphere",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/cds-common-content": "^3.2.0",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "CDS_PLUGIN_UI5_ACTIVE=false node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "watch-vesselcalls": "cds watch --open portsphere.vesselcalls/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-cargomanifests": "cds watch --open portsphere.cargomanifests/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-customsclearance": "cds watch --open portsphere.customsclearance/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-gatepasses": "cds watch --open portsphere.gatepasses/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-deliveryorders": "cds watch --open portsphere.deliveryorders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-portbilling": "cds watch --open portsphere.portbilling/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy portsphere --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/vesselcalls",
    "app/cargomanifests",
    "app/customsclearance",
    "app/gatepasses",
    "app/deliveryorders",
    "app/portbilling"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      }
    }
  }
}
